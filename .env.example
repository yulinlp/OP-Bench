# Copy this file to .env and fill in values locally.
# The public repository intentionally contains no provider keys or endpoint URLs.

# Model used for answer generation, benchmark construction, and optional judges.
OPBENCH_AGENT_MODEL=gpt-4o-mini
OPBENCH_AGENT_API_KEY=
OPBENCH_AGENT_BASE_URL=

# LLM-as-a-judge endpoint. If empty, the agent endpoint is reused.
OPBENCH_SCORER_MODEL=gpt-4o-mini
OPBENCH_SCORER_API_KEY=
OPBENCH_SCORER_BASE_URL=
OPBENCH_EMBEDDING_MODEL=text-embedding-3-small

# Optional OpenAI-compatible multi-agent router settings.
# OPBENCH_AGENT_HOST may be a host-only value, for example http://127.0.0.1.
OPBENCH_AGENT_HOST=
# JSON object, e.g. {"Caroline": 8096, "Jon": 8098}
OPBENCH_AGENT_PORTS=

# MemOS API adapter settings. Select either local or hosted API in the CLI.
MEMOS_API_KEY=
MEMOS_API_BASE_URL=
MEMOS_SEARCH_MODE=fast
